.env
.env.*
!.env.example
*.pem
service-account*.json
gcp-key*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Temp
tmp/
temp/
