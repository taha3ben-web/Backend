# انسخ إلى .env ثم عدّل القيم
NODE_ENV=development
PORT=4000

# نطاقات CORS المسموح بها (مفصولة بفواصل). اتركها فارغة للسماح للجميع (دون اعتمادات).
# مثال للإنتاج: CORS_ORIGINS=https://dashboard.novaride.app,https://admin.novaride.app
CORS_ORIGINS=

# ملاحظة: مع Docker استعمل host=db و host=redis بدل localhost
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova?schema=public
REDIS_URL=redis://localhost:6379

# محرك التوجيه OSRM (مستضاف ذاتيًا). يُقرأ فقط إن لم يُضبط maps.osrmBaseUrl من اللوحة.
OSRM_BASE_URL=http://localhost:5000

# دور العملية: api (طلبات فقط) / worker (مهام مجدولة فقط) / all (الافتراضي)
APP_ROLE=all

# قناة التحقق من الهاتف: firebase (الافتراضي) أو sms
AUTH_OTP_CHANNEL=firebase
# للتطوير فقط (يُتجاهل في الإنتاج): يطبع رمز OTP في اللوغ
OTP_DEV_MODE=false
OTP_PEPPER=change-me-otp-pepper
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# العمولة الافتراضية للشركة (نسبة)
COMPANY_COMMISSION=0.15

# البلد الافتراضي لتطبيع الهاتف عند غياب countryCode من طلب التسجيل/الدخول.
DEFAULT_COUNTRY_CODE=DZ

# مفتاح تجربة A/B النشطة للتسعير؛ عند غياب التجربة يستمر التسعير طبيعيًا.
PRICING_EXPERIMENT_KEY=pricing-fare-v1

# --- جسر الهوية (Firebase Admin) ---
# من Firebase Console → Project Settings → Service Accounts → Generate new private key
# يسمح للخادم بالتحقق من رموز Firebase ID القادمة من تطبيقي الراكب/السائق.
# إذا تركتها فارغة يعمل الخادم طبيعيًا لكن جسر Firebase يبقى معطّلًا.
FIREBASE_PROJECT_ID=nova-ride-4a1e6
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nova-ride-4a1e6.iam.gserviceaccount.com
# ضع المفتاح بين علامتي اقتباس مع \n حرفية للأسطر
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- الإشعارات (Push / SMS / Email) ---
FCM_SERVER_KEY=

# مزود SMS (اختياري)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=NOVA

# مزود البريد (اختياري)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=NOVA Ride <no-reply@novaride.app>

# --- Google Cloud ---
# معرّف مشروع GCP (يُضبط تلقائيًا على Cloud Run باسم GOOGLE_CLOUD_PROJECT)
GCP_PROJECT_ID=
# اسم bucket لتخزين الوثائق/الصور/التقارير (اتركه فارغًا لتعطيل التخزين)
# ---- Cloudflare R2 (التخزين المفضّل) ----
# الأربعة الأولى إلزامية لتفعيل R2؛ وإن نقص أحدها يُسجّل خطأ واضح.
R2_BUCKET=
# مثال: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# اختياري: نطاق عام للقراءة المباشرة (إن تركته فارغاً تُستخدم روابط موقّعة).
R2_PUBLIC_URL=
# ---- Google Cloud Storage (توافق خلفي للملفات القديمة) ----
GCS_BUCKET=
# تفعيل قراءة الأسرار من Secret Manager عند الإقلاع (موصى به في الإنتاج)
USE_SECRET_MANAGER=false

# --- Webhooks الدفع ---
# مرّره إلى مزوّد الدفع أو بوابة التجارب في هيدر x-webhook-token لحماية نقاط webhooks.
PAYMENT_WEBHOOK_TOKEN=

# --- الرصد / المراقبة (Observability) ---
# يحمي نقطتي /api/metrics و /api/metrics/prometheus.
# اضبطه في الإنتاج ثم مرّره: Authorization: Bearer <token>
# اتركه فارغًا لفتح النقطتين (تطوير فقط).
METRICS_TOKEN=

# الحدّ الأقصى لعدد سلاسل مقاييس HTTP المحفوظة في الذاكرة (حماية من انفجار الكاردينالية).
# عند تجاوز الحدّ تُجمَّع المسارات الزائدة تحت route="other" ويزيد nova_http_series_dropped_total.
# الأدنى الفعلي 50 مهما قلّت القيمة.
METRICS_MAX_SERIES=500

# المراقبة (المرحلة 4) — كلّها اختيارية: إن غابت يعمل النظام بالتسجيل المحلي فقط.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_MAX_EVENTS_PER_MINUTE=60
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=nova-backend
OTEL_MAX_BATCH=100
OTEL_FLUSH_INTERVAL_MS=5000
TRACING_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_MS=300000

# مشاركة الرحلة (المرحلة 5): النطاق العام الذي يُبنى عليه رابط المتابعة.
PUBLIC_SHARE_BASE_URL=

# --- مشاركة الرحلة (رابط عام للمتابعة) ---
# النطاق الذي يُبنى عليه رابط "تابع رحلتي"
PUBLIC_SHARE_BASE_URL=
PUBLIC_APP_URL=

# --- التسعير الديناميكي الحيّ (Surge) ---
# false يُعطّل التصاعد تمامًا ويعود للسعر الثابت
SURGE_ENABLED=true
# نسبة الطلب/العرض التي يبدأ عندها التصاعد
SURGE_THRESHOLD=1
SURGE_SENSITIVITY=0.5
SURGE_MAX_MULTIPLIER=3
SURGE_STEP=0.1
# أدنى عدد طلبات لتفعيل التصاعد (يمنع الضجيج)
SURGE_MIN_DEMAND=3

# --- كشف انحراف المسار ---
# يقارن نقاط GPS بمسار محرك التوجيه المحفوظ في routePolyline
ROUTE_DEVIATION_ENABLED=true
# مسافة الخروج عن المسار بالأمتار (ثلاث نقاط متتالية قبل الإنذار)
ROUTE_DEVIATION_THRESHOLD_M=600

# --- إخفاء أرقام الهواتف بين الراكب والسائق ---
# chat_only = حجب كامل والتواصل عبر دردشة الرحلة (الافتراضي)
# twilio  = رقم وسيط حقيقي (يحتاج أرقامًا مشتراة + تنفيذ المحوّل)
CALL_MASKING_PROVIDER=chat_only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# أرقام وسيطة مفصولة بفاصلة
TWILIO_PROXY_NUMBERS=

# أقسام جدول التتبّع (TripTracking) — عدد أشهر الاحتفاظ قبل حذف القسم (1..60)
TRIP_TRACKING_RETENTION_MONTHS=3

# الولاء (يُمنح تلقائيًا بعد تسوية كل رحلة)
LOYALTY_ENABLED=true
LOYALTY_POINTS_PER_UNIT=1
LOYALTY_REDEEM_POINTS_PER_UNIT=100
LOYALTY_MIN_REDEEM_POINTS=500
LOYALTY_REWARD_CURRENCY=DZD
LOYALTY_TIER_SILVER=1000
LOYALTY_TIER_GOLD=5000
LOYALTY_TIER_PLATINUM=20000

# الإحالات (تتأهّل عند أول رحلة مكتملة للمُحال)
REFERRAL_ENABLED=true
REFERRAL_REFERRER_REWARD=200
REFERRAL_REFEREE_REWARD=200
REFERRAL_REWARD_CURRENCY=DZD

# إخفاء أرقام الهواتف (Twilio Voice)
# الأرقام الوسيطة مفصولة بفاصلة؛ كلما زاد عددها زادت المكالمات المتزامنة الممكنة.
TWILIO_PROXY_NUMBERS=
# يجب أن يطابق الرابط المضبوط في لوحة Twilio حرفًا بحرف (وإلا فشل التوقيع).
TWILIO_WEBHOOK_BASE_URL=
TWILIO_DIAL_TIMEOUT_SEC=30
TWILIO_RECORD_CALLS=false

# وضع الاتصال: chat_only (دردشة فقط) | direct (رقم حقيقي) | twilio (رقم وسيط)
CALL_MASKING_PROVIDER=direct
# من يرى الرقم الحقيقي في الوضع المباشر: both | passenger | driver | none
DIRECT_CALL_REVEAL=both

# بوابة البطاقات Chargily Pay v2 (CIB / EDAHABIA)
# اترك CHARGILY_SECRET_KEY فارغًا = المحوّل غير مسجّل أصلًا (نقدًا + محفظة فقط)
CHARGILY_SECRET_KEY=
# test | live  (الافتراضي test)
CHARGILY_MODE=test
# تجاوز يدوي للعنوان إن لزم (اتركه فارغًا عادةً)
CHARGILY_BASE_URL=
# edahabia | cib
CHARGILY_DEFAULT_METHOD=edahabia
CHARGILY_WEBHOOK_URL=
CHARGILY_SUCCESS_URL=
CHARGILY_FAILURE_URL=
CHARGILY_LOCALE=ar

# ---------- Trip archive ----------
# عمر الرحلة بالأشهر قبل أرشفتها (الحدّ الأدنى 3).
TRIP_ARCHIVE_AFTER_MONTHS=12
# عدد الرحلات في كل دفعة أرشفة.
TRIP_ARCHIVE_BATCH_SIZE=200
# تفعيل مهمة الأرشفة المجدولة (معطّلة افتراضيًا حتى تراجع الإعداد).
TRIP_ARCHIVE_ENABLED=false

# مزوّد البريد: resend | sendgrid | generic
# resend/sendgrid يحتاجان EMAIL_API_KEY فقط؛ generic يحتاج EMAIL_API_URL أيضًا
EMAIL_PROVIDER=resend
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=10000
EMAIL_BRAND_NAME=flaminGO
EMAIL_BRAND_COLOR=#D4AF37
EMAIL_BRAND_BACKGROUND=#111111
EMAIL_SUPPORT_ADDRESS=support@novaride.app
EMAIL_APP_URL=
