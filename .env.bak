# انسخ إلى .env ثم عدّل القيم
NODE_ENV=development
PORT=4000

# نطاقات CORS المسموح بها (مفصولة بفواصل). اتركها فارغة للسماح للجميع (دون اعتمادات).
# مثال للإنتاج: CORS_ORIGINS=https://dashboard.novaride.app,https://admin.novaride.app
CORS_ORIGINS=

# ملاحظة: مع Docker استعمل host=db و host=redis بدل localhost
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# العمولة الافتراضية للشركة (نسبة)
COMPANY_COMMISSION=0.15

# --- جسر الهوية (Firebase Admin) ---
# من Firebase Console → Project Settings → Service Accounts → Generate new private key
# يسمح للخادم بالتحقق من رموز Firebase ID القادمة من تطبيقي الراكب/السائق.
# إذا تركتها فارغة يعمل الخادم طبيعيًا لكن جسر Firebase يبقى معطّلًا.
FIREBASE_PROJECT_ID=nova-ride-4a1e6
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nova-ride-4a1e6.iam.gserviceaccount.com
# ضع المفتاح بين علامتي اقتباس مع \n حرفية للأسطر
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- الإشعارات (Push / SMS / Email) ---
FCM_SERVER_KEY=

# --- Google Cloud ---
# معرّف مشروع GCP (يُضبط تلقائيًا على Cloud Run باسم GOOGLE_CLOUD_PROJECT)
GCP_PROJECT_ID=
# اسم bucket لتخزين الوثائق/الصور/التقارير (اتركه فارغًا لتعطيل التخزين)
GCS_BUCKET=
# تفعيل قراءة الأسرار من Secret Manager عند الإقلاع (موصى به في الإنتاج)
USE_SECRET_MANAGER=false

# --- الرصد / المراقبة (Observability) ---
# يحمي نقطتي /api/metrics و /api/metrics/prometheus.
# اضبطه في الإنتاج ثم مرّره: Authorization: Bearer <token>
# اتركه فارغًا لفتح النقطتين (تطوير فقط).
METRICS_TOKEN=
