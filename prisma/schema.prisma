// NOVA Ride — Production database schema (PostgreSQL + Prisma)
// يغطي جميع الجداول المطلوبة مع العلاقات الصحيحة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum UserType {
  PASSENGER
  DRIVER
  STAFF
  AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  ON_TRIP
}

enum RideClass {
  ECONOMY
  COMFORT
  VAN
  XL
  CAR
  BIKE
}

enum WorkflowStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum DocumentType {
  LICENSE
  ID_CARD
  INSURANCE
  REGISTRATION
  PROFILE_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  SEARCHING
  ACCEPTED
  ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActorKind {
  PASSENGER
  DRIVER
  SYSTEM
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum FundingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FUNDED
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum FinancialPartyType {
  USER
  AGENT
  PLATFORM
  EXTERNAL
}

enum FinancialAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
  CANCELLED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  INVITED
}


enum DiscountType {
  PERCENT
  FIXED
}

enum NotificationTarget {
  ALL
  DRIVERS
  PASSENGERS
  USER
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ComplaintStatus {
  OPEN
  REVIEWING
  RESOLVED
}

// ---------- Core identity ----------
model User {
  id           String     @id @default(uuid())
  name         String
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  firebaseUid  String?    @unique
  type         UserType   @default(PASSENGER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  locale       String     @default("ar")
  staffRoleId  String?
  staffRole    Role?      @relation(fields: [staffRoleId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  driver             Driver?
  agentProfile       AgentProfile?
  wallet             Wallet?
  financialParty     FinancialParty?
  passengerTrips     Trip[]             @relation("PassengerTrips")
  payments           Payment[]
  withdrawRequests   WithdrawRequest[]
  requestedFundingRequests DriverFundingRequest[] @relation("FundingRequester")
  approvedFundingRequests  DriverFundingRequest[] @relation("FundingApprover")
  refreshTokens      RefreshToken[]
  sessions           Session[]
  deviceTokens       DeviceToken[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
  supportMessages    SupportMessage[]
  ratingsGiven       Rating[]           @relation("RatingAuthor")
  ratingsReceived    Rating[]           @relation("RatingTarget")
  complaintsFiled    Complaint[]        @relation("ComplaintFrom")
  complaintsAgainst  Complaint[]        @relation("ComplaintAgainst")
  complaintsResolved Complaint[]        @relation("ComplaintResolver")
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]
  emergencyContacts  EmergencyContact[]
  reviewedDocuments  DriverDocument[]   @relation("DocumentReviewer")
  createdAgents      AgentProfile[]     @relation("AgentCreator")

  @@index([type])
  @@index([status])
}

model Driver {
  id           String             @id @default(uuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DriverStatus       @default(PENDING)
  availability DriverAvailability @default(OFFLINE)
  rating       Float              @default(5)
  totalTrips   Int                @default(0)
  cityId       String?
  city         City?              @relation(fields: [cityId], references: [id])
  currentLat   Float?
  currentLng   Float?
  lastSeenAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  vehicles         Vehicle[]
  documents        DriverDocument[]
  trips            Trip[]            @relation("DriverTrips")
  earnings         DriverEarning[]
  withdrawRequests WithdrawRequest[]
  fundingRequests  DriverFundingRequest[]

  @@index([status])
  @@index([availability])
  @@index([availability, status])
  @@index([cityId])
}

model Vehicle {
  id        String    @id @default(uuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make      String
  model     String
  year      Int?
  color     String?
  plate     String    @unique
  rideClass RideClass @default(ECONOMY)
  vehicleTypeId String?
  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([driverId])
  @@index([vehicleTypeId])
}

model DriverDocument {
  id           String         @id @default(uuid())
  driverId     String
  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type         DocumentType
  url          String
  status       DocumentStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  note         String?
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([driverId])
  @@index([status])
}

// ---------- Trips ----------
model Trip {
  id            String        @id @default(uuid())
  passengerId   String
  passenger     User          @relation("PassengerTrips", fields: [passengerId], references: [id])
  driverId      String?
  driver        Driver?       @relation("DriverTrips", fields: [driverId], references: [id])
  status        TripStatus    @default(SEARCHING)
  rideClass     RideClass     @default(ECONOMY)
  vehicleTypeId String?
  vehicleType   VehicleType?  @relation(fields: [vehicleTypeId], references: [id])
  pickupLat     Float
  pickupLng     Float
  pickupAddress String?
  destLat       Float?
  destLng       Float?
  destAddress   String?
  distanceKm    Float?
  durationSec   Int?
  fare          Decimal?      @db.Decimal(12, 2)
  currency      String        @default("DZD")
  paymentMethod PaymentMethod @default(CASH)
  cancelReason  String?
  cancelledBy   ActorKind?
  cityId        String?
  city          City?         @relation(fields: [cityId], references: [id])
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  settlementAttempts Int      @default(0)
  settlementError String?
  settledAt      DateTime?
  updatedAt     DateTime      @updatedAt

  tracking       TripTracking[]
  events         TripEvent[]
  payment        Payment?
  ratings        Rating[]
  complaints     Complaint[]
  driverEarning  DriverEarning?
  companyEarning CompanyEarning?

  @@index([status])
  @@index([passengerId])
  @@index([driverId])
  @@index([passengerId, status])
  @@index([driverId, status])
  @@index([createdAt])
  @@index([status, settledAt, completedAt])
}

model TripTracking {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  heading    Float?
  speed      Float?
  recordedAt DateTime @default(now())

  @@index([tripId, recordedAt])
}

model TripEvent {
  id        String    @id @default(uuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      String
  actor     ActorKind @default(SYSTEM)
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([tripId, createdAt])
}

// ---------- Money ----------
model FinancialParty {
  id          String             @id @default(uuid())
  type        FinancialPartyType
  userId      String?            @unique
  user        User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName String
  countryCode String             @default("DZ")
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  accounts    FinancialAccount[]

  @@index([type])
}

model FinancialAccount {
  id            String               @id @default(uuid())
  partyId       String
  party         FinancialParty       @relation(fields: [partyId], references: [id], onDelete: Restrict)
  code          String               @unique
  type          FinancialAccountType
  currency      String               @db.Char(3)
  balanceCache  Decimal              @default(0) @db.Decimal(18, 2)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  entries       LedgerEntry[]

  @@index([partyId, currency])
}

model LedgerTransaction {
  id              String                  @id @default(uuid())
  command         String
  idempotencyKey  String                  @unique
  status          LedgerTransactionStatus @default(PENDING)
  currency        String                  @db.Char(3)
  referenceType   String?
  referenceId     String?
  metadata        Json?
  failureReason   String?
  reversalOfId    String?                 @unique
  reversalOf      LedgerTransaction?      @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      LedgerTransaction?      @relation("LedgerReversal")
  createdAt       DateTime                @default(now())
  postedAt        DateTime?
  entries         LedgerEntry[]

  @@index([status, createdAt])
  @@index([referenceType, referenceId])
}

model LedgerEntry {
  id            String               @id @default(uuid())
  transactionId String
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     LedgerEntryDirection
  amount        Decimal              @db.Decimal(18, 2)
  createdAt     DateTime             @default(now())

  @@unique([transactionId, accountId, direction])
  @@index([accountId, createdAt])
  @@index([transactionId])
}

model DriverEarning {
  id         String   @id @default(uuid())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id])
  tripId     String   @unique
  trip       Trip     @relation(fields: [tripId], references: [id])
  gross      Decimal  @db.Decimal(12, 2)
  commission Decimal  @db.Decimal(12, 2)
  net        Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([driverId])
}

model CompanyEarning {
  id        String   @id @default(uuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  source    String   @default("commission")
  createdAt DateTime @default(now())
}

model Payment {
  id                String         @id @default(uuid())
  tripId            String         @unique
  trip              Trip           @relation(fields: [tripId], references: [id])
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  amount            Decimal        @db.Decimal(12, 2)
  method            PaymentMethod  @default(CASH)
  provider          String         @default("manual")
  providerPaymentId String?
  providerStatus    String?
  status            PaymentStatus  @default(PENDING)
  statusReason      String?
  reference         String?
  metadata          Json?
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  canceledAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  events            PaymentEvent[]

  @@index([userId])
  @@index([provider, status, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id             String   @id @default(uuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type           String
  status         String?
  provider       String?
  idempotencyKey String?  @unique
  reference      String?
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([type, createdAt])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("DZD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String       @id @default(uuid())
  walletId     String
  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTxType
  amount       Decimal      @db.Decimal(12, 2)
  balanceAfter Decimal      @db.Decimal(12, 2)
  reason       String?
  createdAt    DateTime     @default(now())

  @@index([walletId, createdAt])
}

model DriverFundingRequest {
  id            String               @id @default(uuid())
  driverId      String
  driver        Driver               @relation(fields: [driverId], references: [id])
  requestedById String
  requestedBy   User                 @relation("FundingRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?                @relation("FundingApprover", fields: [approvedById], references: [id])
  amount        Decimal              @db.Decimal(12, 2)
  status        FundingRequestStatus @default(PENDING)
  note          String?
  idempotencyKey String              @unique
  approvedAt    DateTime?
  fundedAt      DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([driverId, status])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}

model WithdrawRequest {
  id            String         @id @default(uuid())
  driverId      String
  driver        Driver         @relation(fields: [driverId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  amount        Decimal        @db.Decimal(12, 2)
  status        WithdrawStatus @default(PENDING)
  processedById String?
  note          String?
  createdAt     DateTime       @default(now())
  processedAt   DateTime?

  @@index([driverId])
  @@index([status, createdAt])
  @@index([userId, status])
}

// ---------- Marketing ----------
model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  type         DiscountType @default(PERCENT)
  value        Decimal      @db.Decimal(12, 2)
  maxUses      Int?
  usedCount    Int          @default(0)
  firstRideOnly Boolean     @default(false)
  userId       String?
  expiresAt    DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  trips Trip[]
}

model PromoCode {
  id           String       @id @default(uuid())
  code         String       @unique
  description  String?
  discountType DiscountType @default(PERCENT)
  value        Decimal      @db.Decimal(12, 2)
  isActive     Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
}

// ---------- Communication ----------
model Notification {
  id          String              @id @default(uuid())
  target      NotificationTarget  @default(USER)
  channel     NotificationChannel @default(PUSH)
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  title       String
  body        String
  data        Json?
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId])
  @@index([target])
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  category  String?
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages SupportMessage[]

  @@index([status])
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Rating {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  authorId  String
  author    User     @relation("RatingAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("RatingTarget", fields: [targetId], references: [id])
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([tripId])
}

model Complaint {
  id            String          @id @default(uuid())
  tripId        String?
  trip          Trip?           @relation(fields: [tripId], references: [id])
  fromUserId    String
  fromUser      User            @relation("ComplaintFrom", fields: [fromUserId], references: [id])
  againstUserId String?
  againstUser   User?           @relation("ComplaintAgainst", fields: [againstUserId], references: [id])
  message       String
  status        ComplaintStatus @default(OPEN)
  resolvedById  String?
  resolvedBy    User?           @relation("ComplaintResolver", fields: [resolvedById], references: [id])
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

// ---------- RBAC ----------
model AgentProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentCode   String      @unique
  status      AgentStatus @default(ACTIVE)
  cityId      String?
  city        City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  notes       String?
  createdById String?
  createdBy   User?       @relation("AgentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastLoginAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, cityId])
  @@index([createdById])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------- Geography & pricing ----------
model City {
  id        String   @id @default(uuid())
  name      String
  country   String?
  isActive  Boolean  @default(true)
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())

  zones        Zone[]
  pricingRules PricingRule[]
  drivers      Driver[]
  agents       AgentProfile[]
  trips        Trip[]
}

model Zone {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String
  polygon   Json?
  createdAt DateTime @default(now())

  @@index([cityId])
}

model PricingRule {
  id        String    @id @default(uuid())
  cityId    String?
  city      City?     @relation(fields: [cityId], references: [id])
  rideClass RideClass @default(ECONOMY)
  baseFare  Decimal   @db.Decimal(12, 2)
  perKm     Decimal   @db.Decimal(12, 2)
  perMin    Decimal   @db.Decimal(12, 2)
  minFare   Decimal   @db.Decimal(12, 2)
  maxFare   Decimal?  @db.Decimal(12, 2)
  currency  String    @default("DZD")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  peakPricing PeakPricing[]

  @@index([cityId])
}

model PeakPricing {
  id            String      @id @default(uuid())
  pricingRuleId String
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)
  name          String
  multiplier    Float       @default(1.5)
  startTime     String
  endTime       String
  daysOfWeek    Int[]
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([pricingRuleId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  relation  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Platform / system ----------
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  group     String?
  updatedAt DateTime @updatedAt
}

model AppVersion {
  id           String   @id @default(uuid())
  platform     String
  version      String
  minSupported String?
  forceUpdate  Boolean  @default(false)
  url          String?
  createdAt    DateTime @default(now())

  @@index([platform])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, revoked])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("info")
  message   String
  context   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
}

/// أنواع المركبات المعروضة في التطبيق (اقتصادي، مريح، فان...) — تُدار من لوحة التحكم
// فئة مركبات ديناميكية (سيارات / دراجات / أي فئة جديدة يضيفها المدير).
model VehicleCategory {
  id              String   @id @default(uuid())
  name            String   @unique
  nameI18n        Json? // { ar, fr, en }
  description     String?
  descriptionI18n Json?
  iconType        String   @default("EMOJI") // EMOJI | ICON_PACK | SVG | PNG | LOTTIE
  iconValue       String? // رمز إيموجي أو مفتاح داخل حزمة أيقونات
  iconUrl         String? // رابط ملف SVG/PNG/Lottie (URL أو File ID فقط)
  imageUrl        String?
  color           String?
  usageType       String   @default("BOTH") // RIDE | DELIVERY | BOTH
  domain          String   @default("MOBILITY") // MOBILITY | FOOD | PARCEL | CORPORATE | RENTAL — كتالوج قابل لإعادة الاستخدام
  status          WorkflowStatus @default(PUBLISHED)
  version         Int      @default(1) // يتغير مع كل تعديل — للـ smart cache
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  deletedAt       DateTime? // حذف ناعم
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  types VehicleType[]

  @@index([isActive])
  @@index([domain])
  @@index([deletedAt])
}

// نوع المركبة = خدمة كاملة. كل الخصائص والميزات والأسعار تُدار من لوحة التحكم.
model VehicleType {
  id              String           @id @default(uuid())
  categoryId      String?
  category        VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  nameI18n        Json?
  description     String?
  descriptionI18n Json?
  rideClass       RideClass        @default(ECONOMY) // للتوافق مع البيانات القديمة
  multiplier      Float            @default(1)
  capacity        Int              @default(4)
  luggage         Int              @default(0)
  notes           String?
  usageType       String           @default("BOTH") // RIDE | DELIVERY | BOTH

  // خصائص الخدمة (تُدار من اللوحة)
  allowsNegotiation   Boolean @default(false)
  supportsCash        Boolean @default(true)
  supportsWallet      Boolean @default(true)
  requiresApproval    Boolean @default(false)
  visibleToPassengers Boolean @default(true)
  visibleToDrivers    Boolean @default(true)

  // أيقونات مرنة (Icon Pack / SVG / PNG / Lottie)
  iconType  String  @default("EMOJI")
  iconValue String?
  iconUrl   String?
  imageUrl  String?
  color     String?

  // متطلبات القبول لهذا النوع — يتحقق منها النظام تلقائياً
  minVehicleYear      Int?
  minDriverRating     Float?
  minDriverTrips      Int?
  requiredLicenseType String?
  requiredDocuments   String[] @default([]) // أنواع مستندات إلزامية
  requiredPhotos      String[] @default([]) // صور إلزامية
  requirements        Json? // متطلبات إضافية مرنة

  // دورة حياة النشر (Workflow) + الإصدار + الحذف الناعم
  status    WorkflowStatus @default(DRAFT)
  version   Int       @default(1)
  deletedAt DateTime?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features     VehicleTypeFeature[]
  pricingRules VehiclePricingRule[]
  fields       VehicleTypeField[]
  vehicles     Vehicle[]
  trips        Trip[]

  @@unique([categoryId, name])
  @@index([isActive])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

// ميزات مرنة (مكيف/براد/واي فاي/شاحن/كرسي أطفال...) تُضاف من اللوحة دون تعديل قاعدة البيانات.
model Feature {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameI18n  Json?
  iconType  String   @default("EMOJI")
  iconValue String?
  iconUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  types VehicleTypeFeature[]

  @@index([isActive])
  @@index([deletedAt])
}

// جدول الربط بين النوع والميزات (متعدد-إلى-متعدد).
model VehicleTypeFeature {
  vehicleTypeId String
  featureId     String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  feature       Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([vehicleTypeId, featureId])
  @@index([featureId])
}

// مناطق الخدمة (اسم/مدينة/ولاية/دولة/حدود GeoJSON/تفعيل). يرتبط بها التسعير.
model ServiceArea {
  id        String   @id @default(uuid())
  name      String
  city      String?
  state     String?
  country   String?
  geojson     Json? // Polygon / GeoJSON — تمثيل هندسي عام مستقل عن مزوّد الخرائط
  provider    String   @default("GEOJSON") // GEOJSON | GOOGLE | OSM | MAPBOX
  providerRef Json? // معرفات خاصة بالمزوّد (اختياري) دون تغيير المخطط
  centerLat Float?
  centerLng Float?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules VehiclePricingRule[]

  @@index([isActive])
  @@index([deletedAt])
}

// نظام تسعير مرن: عدة قواعد سعر لكل نوع مركبة، تختلف حسب المنطقة/المدينة/الولاية/الدولة/
// الوقت/الذروة/المناسبات/نوع العميل/العروض/الكوبونات. يُختار أنسبها حسب الأولوية والتطابق.
model VehiclePricingRule {
  id            String       @id @default(uuid())
  vehicleTypeId String
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  name          String?

  // النطاق الجغرافي
  serviceAreaId String?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  cityId        String?
  state         String?
  country       String?

  // نوع العميل والعروض والكوبونات
  customerType String? // ALL | NEW | VIP ...
  couponCode   String?

  // النافذة الزمنية / المناسبات / الذروة
  validFrom      DateTime?
  validTo        DateTime?
  daysOfWeek     Int[]     @default([])
  startTime      String? // HH:MM
  endTime        String? // HH:MM
  peakMultiplier Float     @default(1)

  // القيم
  baseFare       Decimal  @db.Decimal(12, 2)
  perKm          Decimal  @db.Decimal(12, 2)
  perMin         Decimal  @db.Decimal(12, 2)
  minFare        Decimal  @db.Decimal(12, 2)
  maxFare        Decimal? @db.Decimal(12, 2)
  negotiationMin Decimal? @db.Decimal(12, 2)
  negotiationMax Decimal? @db.Decimal(12, 2)
  commissionPct  Float    @default(0)
  currency       String   @default("DZD")

  priority  Int      @default(0) // الأعلى يفوز عند تطابق أكثر من قاعدة
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleTypeId])
  @@index([serviceAreaId])
  @@index([isActive])
  @@index([deletedAt])
}

// حقول ديناميكية يعرّفها المدير لكل نوع (Dynamic Forms) دون تعديل الكود.
model VehicleTypeField {
  id            String      @id @default(uuid())
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  key           String // مفتاح برمجي، مثل: hasWater
  label         String
  labelI18n     Json? // { ar, fr, en }
  fieldType     String      @default("TEXT") // TEXT | NUMBER | BOOLEAN | SELECT | MULTISELECT
  options       Json? // خيارات SELECT/MULTISELECT
  required      Boolean     @default(false)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([vehicleTypeId, key])
  @@index([vehicleTypeId])
}

/// الإعلانات/البانرات المعروضة في تطبيقي الراكب والسائق
model Advertisement {
  id        String      @id @default(uuid())
  title     String
  imageUrl  String
  targetUrl String?
  placement AdPlacement @default(PASSENGER_HOME)
  isActive  Boolean     @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([placement, isActive])
}

enum AdPlacement {
  PASSENGER_HOME
  PASSENGER_SEARCH
  DRIVER_HOME
  ALL
}
