// NOVA Ride — Production database schema (PostgreSQL + Prisma)
// يغطي جميع الجداول المطلوبة مع العلاقات الصحيحة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum UserType {
  PASSENGER
  DRIVER
  STAFF
  AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  ON_TRIP
}

enum RideClass {
  ECONOMY
  COMFORT
  VAN
  XL
  CAR
  BIKE
}

enum WorkflowStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum DocumentType {
  LICENSE
  ID_CARD
  INSURANCE
  REGISTRATION
  PROFILE_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  SCHEDULED
  SEARCHING
  ACCEPTED
  ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SettlementStatus {
  NOT_REQUIRED
  PENDING
  RETRYING
  FAILED
  POSTED
}

enum ActorKind {
  PASSENGER
  DRIVER
  SYSTEM
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum FundingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FUNDED
}

enum DriverTransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum FinancialPartyType {
  USER
  AGENT
  PLATFORM
  EXTERNAL
}

enum FinancialAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
  CANCELLED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum DriverQrStatus {
  ACTIVE
  REVOKED
}


enum DiscountType {
  PERCENT
  FIXED
}

enum CouponFundingSource {
  PLATFORM
  DRIVER
  SHARED
}

// ===== Stage 63: Subscriptions (khutat ishtirak al-rukkab) =====
enum SubscriptionInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model SubscriptionPlan {
  id                 String               @id @default(uuid())
  code               String               @unique
  name               String
  description        String?
  price              Decimal              @db.Decimal(12, 2)
  currency           String               @default("DZD")
  interval           SubscriptionInterval @default(MONTHLY)
  benefitDiscountPct Float                @default(0)
  benefitMaxDiscount Decimal?             @db.Decimal(12, 2)
  perks              Json?
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  subscriptions      UserSubscription[]

  @@index([isActive])
}

model UserSubscription {
  id               String             @id @default(uuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  autoRenew        Boolean            @default(true)
  lastChargedAt    DateTime?
  renewalAttempts  Int                @default(0)
  renewalError     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id])
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

enum NotificationTarget {
  ALL
  DRIVERS
  PASSENGERS
  USER
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ComplaintStatus {
  OPEN
  REVIEWING
  RESOLVED
}

// ---------- Core identity ----------
model User {
  id           String     @id @default(uuid())
  name         String
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  firebaseUid  String?    @unique
  type         UserType   @default(PASSENGER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  locale       String     @default("ar")
  staffRoleId  String?
  staffRole    Role?      @relation(fields: [staffRoleId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  driver             Driver?
  agentProfile       AgentProfile?
  financialParty     FinancialParty?
  passengerTrips     Trip[]             @relation("PassengerTrips")
  payments           Payment[]
  withdrawRequests   WithdrawRequest[]
  requestedFundingRequests DriverFundingRequest[] @relation("FundingRequester")
  approvedFundingRequests  DriverFundingRequest[] @relation("FundingApprover")
  refreshTokens      RefreshToken[]
  sessions           Session[]
  deviceTokens       DeviceToken[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
  supportMessages    SupportMessage[]
  ratingsGiven       Rating[]           @relation("RatingAuthor")
  ratingsReceived    Rating[]           @relation("RatingTarget")
  complaintsFiled    Complaint[]        @relation("ComplaintFrom")
  complaintsAgainst  Complaint[]        @relation("ComplaintAgainst")
  complaintsResolved Complaint[]        @relation("ComplaintResolver")
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]
  emergencyContacts  EmergencyContact[]
  reviewedDocuments  DriverDocument[]   @relation("DocumentReviewer")
  createdAgents      AgentProfile[]     @relation("AgentCreator")
  issuedDriverQrCodes DriverQrCode[]     @relation("DriverQrIssuer")
  revokedDriverQrCodes DriverQrCode[]    @relation("DriverQrRevoker")
  requestedDriverTransfers DriverTransfer[] @relation("DriverTransferRequester")
  reviewedDriverTransfers  DriverTransfer[] @relation("DriverTransferReviewer")
  consents           UserConsent[]
  savedPlaces        SavedPlace[]
  subscriptions      UserSubscription[]
  identityVerifications         UserIdentityVerification[] @relation("UserIdentities")
  reviewedIdentityVerifications UserIdentityVerification[] @relation("IdentityReviewer")
  verifiedVehicles              Vehicle[]                  @relation("VehicleVerifier")
  requestedSettingChanges       SettingChangeRequest[]     @relation("SettingChangeRequester")
  reviewedSettingChanges        SettingChangeRequest[]     @relation("SettingChangeReviewer")

  @@index([type])
  @@index([status])
}

model Driver {
  id           String             @id @default(uuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DriverStatus       @default(PENDING)
  availability DriverAvailability @default(OFFLINE)
  rating       Float              @default(5)
  totalTrips   Int                @default(0)
  cityId       String?
  city         City?              @relation(fields: [cityId], references: [id])
  currentLat   Float?
  currentLng   Float?
  lastSeenAt   DateTime?
  // نظام عقوبات الإلغاء (Stage 65): تعليق مؤقت يُرفع تلقائيًا، عدّاد تصعيد، وآخر عقوبة.
  suspendedUntil      DateTime?
  cancellationStrikes Int        @default(0)
  lastSanctionAt      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  vehicles         Vehicle[]
  documents        DriverDocument[]
  trips            Trip[]            @relation("DriverTrips")
  earnings         DriverEarning[]
  withdrawRequests WithdrawRequest[]
  fundingRequests  DriverFundingRequest[]
  qrCodes          DriverQrCode[]
  sanctions        DriverSanction[]
  outgoingTransfers DriverTransfer[]      @relation("OutgoingDriverTransfers")
  incomingTransfers DriverTransfer[]      @relation("IncomingDriverTransfers")

  @@index([status])
  @@index([availability])
  @@index([availability, status])
  @@index([cityId])
}

// Stage 65: سجل عقوبات إلغاء السائق (تحذير/تعليق/حظر) للمراجعة والتدقيق.
model DriverSanction {
  id                String    @id @default(uuid())
  driverId          String
  driver            Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  level             String
  cancellationCount Int
  windowStart       DateTime
  windowEnd         DateTime
  suspendedUntil    DateTime?
  reason            String?
  createdAt         DateTime  @default(now())

  @@index([driverId])
  @@index([createdAt])
}

model DriverQrCode {
  id               String         @id @default(uuid())
  driverId         String
  driver           Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  publicIdentifier String         @unique
  status           DriverQrStatus @default(ACTIVE)
  issuedById       String?
  issuedBy         User?          @relation("DriverQrIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedById      String?
  revokedBy        User?          @relation("DriverQrRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([driverId, status])
  @@index([status, expiresAt])
}

model Vehicle {
  id        String    @id @default(uuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make      String
  model     String
  year      Int?
  color     String?
  plate     String    @unique
  rideClass RideClass @default(ECONOMY)
  vehicleTypeId String?
  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  isActive  Boolean   @default(true)
  verificationStatus VehicleVerificationStatus @default(PENDING)
  verificationNote   String?
  verifiedById       String?
  verifiedBy         User?     @relation("VehicleVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  createdAt DateTime  @default(now())

  @@index([driverId])
  @@index([vehicleTypeId])
  @@index([verificationStatus])
}

model DriverDocument {
  id           String         @id @default(uuid())
  driverId     String
  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type         DocumentType
  url          String
  status       DocumentStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  note         String?
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([driverId])
  @@index([status])
}

// ---------- Trips ----------
model Trip {
  id            String        @id @default(uuid())
  passengerId   String
  passenger     User          @relation("PassengerTrips", fields: [passengerId], references: [id])
  driverId      String?
  driver        Driver?       @relation("DriverTrips", fields: [driverId], references: [id])
  status        TripStatus    @default(SEARCHING)
  rideClass     RideClass     @default(ECONOMY)
  vehicleTypeId String?
  vehicleType   VehicleType?  @relation(fields: [vehicleTypeId], references: [id])
  pickupLat     Float
  pickupLng     Float
  pickupAddress String?
  destLat       Float?
  destLng       Float?
  destAddress   String?
  distanceKm    Float?
  durationSec   Int?
  fare          Decimal?      @db.Decimal(12, 2)
  commissionPct Float         @default(15)
  currency      String
  paymentMethod PaymentMethod @default(CASH)
  cancelReason  String?
  cancelledBy   ActorKind?
  cancellationFee Decimal?    @db.Decimal(12, 2)
  cancellationSettledAt DateTime?
  cancellationSettlementAttempts Int @default(0)
  cancellationSettlementError String?
  cityId        String?
  city          City?         @relation(fields: [cityId], references: [id])
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  discountAmount Decimal?     @db.Decimal(12, 2)
  couponFundingSource CouponFundingSource?
  couponPlatformShare Decimal? @db.Decimal(5, 4)
  createdAt     DateTime      @default(now())
  acceptedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  settlementAttempts Int      @default(0)
  settlementError String?
  settlementStatus SettlementStatus @default(NOT_REQUIRED)
  settledAt      DateTime?
  isScheduled   Boolean       @default(false)
  scheduledAt   DateTime?
  dispatchAt    DateTime?
  updatedAt     DateTime      @updatedAt

  stops          TripStop[]
  tracking       TripTracking[]
  events         TripEvent[]
  payment        Payment?
  ratings        Rating[]
  complaints     Complaint[]
  driverEarning  DriverEarning?
  companyEarning CompanyEarning?

  @@index([status])
  @@index([passengerId])
  @@index([driverId])
  @@index([passengerId, status])
  @@index([driverId, status])
  @@index([createdAt])
  @@index([status, settledAt, completedAt])
  @@index([settlementStatus])
}

model TripTracking {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  heading    Float?
  speed      Float?
  recordedAt DateTime @default(now())

  @@index([tripId, recordedAt])
}

model TripEvent {
  id        String    @id @default(uuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      String
  actor     ActorKind @default(SYSTEM)
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([tripId, createdAt])
}

// ---------- Money ----------
model FinancialParty {
  id          String             @id @default(uuid())
  type        FinancialPartyType
  userId      String?            @unique
  user        User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName String
  countryCode String             @default("DZ")
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  accounts    FinancialAccount[]

  @@index([type])
}

model FinancialAccount {
  id            String               @id @default(uuid())
  partyId       String
  party         FinancialParty       @relation(fields: [partyId], references: [id], onDelete: Restrict)
  code          String               @unique
  type          FinancialAccountType
  currency      String               @db.Char(3)
  balanceCache  Decimal              @default(0) @db.Decimal(18, 2)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  entries       LedgerEntry[]

  @@index([partyId, currency])
}

model LedgerTransaction {
  id              String                  @id @default(uuid())
  command         String
  idempotencyKey  String                  @unique
  status          LedgerTransactionStatus @default(PENDING)
  currency        String                  @db.Char(3)
  referenceType   String?
  referenceId     String?
  metadata        Json?
  createdBy       String?
  reason          String?
  failureReason   String?
  reversalOfId    String?                 @unique
  reversalOf      LedgerTransaction?      @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      LedgerTransaction?      @relation("LedgerReversal")
  createdAt       DateTime                @default(now())
  postedAt        DateTime?
  entries         LedgerEntry[]

  @@index([status, createdAt])
  @@index([referenceType, referenceId])
}

model LedgerEntry {
  id            String               @id @default(uuid())
  transactionId String
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     LedgerEntryDirection
  amount        Decimal              @db.Decimal(18, 2)
  currency      String?              @db.Char(3)
  role          String?
  balanceAfter  Decimal?             @db.Decimal(18, 2)
  createdAt     DateTime             @default(now())

  @@unique([transactionId, accountId, direction])
  @@index([accountId, createdAt])
  @@index([transactionId])
}

enum ReconciliationStatus {
  OPEN
  RESOLVED
  IGNORED
}

model LedgerReconciliationIncident {
  id             String               @id @default(uuid())
  accountId      String
  accountCode    String
  currency       String               @db.Char(3)
  cachedBalance  Decimal              @db.Decimal(18, 2)
  derivedBalance Decimal              @db.Decimal(18, 2)
  difference     Decimal              @db.Decimal(18, 2)
  status         ReconciliationStatus @default(OPEN)
  detail         String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([accountId])
}

model DriverEarning {
  id         String   @id @default(uuid())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id])
  tripId     String   @unique
  trip       Trip     @relation(fields: [tripId], references: [id])
  gross      Decimal  @db.Decimal(12, 2)
  commission Decimal  @db.Decimal(12, 2)
  net        Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([driverId])
}

model CompanyEarning {
  id        String   @id @default(uuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  source    String   @default("commission")
  createdAt DateTime @default(now())
}

model Payment {
  id                String         @id @default(uuid())
  tripId            String         @unique
  trip              Trip           @relation(fields: [tripId], references: [id])
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  amount            Decimal        @db.Decimal(12, 2)
  method            PaymentMethod  @default(CASH)
  provider          String         @default("manual")
  providerPaymentId String?
  providerStatus    String?
  status            PaymentStatus  @default(PENDING)
  statusReason      String?
  reference         String?
  metadata          Json?
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  canceledAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  events            PaymentEvent[]

  @@index([userId])
  @@index([provider, status, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id             String   @id @default(uuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type           String
  status         String?
  provider       String?
  idempotencyKey String?  @unique
  reference      String?
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

// لقطة تدقيق غير تشغيلية تحفظ بيانات Wallet القديمة بعد ترحيل المصدر إلى Ledger.
// لا تُستخدم لحساب الرصيد ولا تقبل كتابات من مسارات التطبيق.
model LegacyWalletArchive {
  id           String   @id
  userId       String   @unique
  balance      Decimal  @db.Decimal(12, 2)
  currency     String
  transactions Json
  archivedAt   DateTime @default(now())
}

model DriverFundingRequest {
  id            String               @id @default(uuid())
  driverId      String
  driver        Driver               @relation(fields: [driverId], references: [id])
  requestedById String
  requestedBy   User                 @relation("FundingRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?                @relation("FundingApprover", fields: [approvedById], references: [id])
  amount        Decimal              @db.Decimal(12, 2)
  status        FundingRequestStatus @default(PENDING)
  note          String?
  idempotencyKey String              @unique
  approvedAt    DateTime?
  fundedAt      DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([driverId, status])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}

model DriverTransfer {
  id             String               @id @default(uuid())
  fromDriverId   String
  fromDriver     Driver               @relation("OutgoingDriverTransfers", fields: [fromDriverId], references: [id])
  toDriverId     String
  toDriver       Driver               @relation("IncomingDriverTransfers", fields: [toDriverId], references: [id])
  requestedById  String
  requestedBy    User                 @relation("DriverTransferRequester", fields: [requestedById], references: [id])
  reviewedById   String?
  reviewedBy     User?                @relation("DriverTransferReviewer", fields: [reviewedById], references: [id])
  amount         Decimal              @db.Decimal(12, 2)
  status         DriverTransferStatus @default(PENDING)
  note           String?
  idempotencyKey String               @unique
  riskFlags      Json?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([fromDriverId, status])
  @@index([toDriverId, status])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}

model WithdrawRequest {
  id            String         @id @default(uuid())
  driverId      String
  driver        Driver         @relation(fields: [driverId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  amount        Decimal        @db.Decimal(12, 2)
  status         WithdrawStatus @default(PENDING)
  processedById  String?
  note           String?
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  processedAt    DateTime?

  @@index([driverId])
  @@index([status, createdAt])
  @@index([userId, status])
}

// ---------- Marketing ----------
model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  type         DiscountType @default(PERCENT)
  value        Decimal      @db.Decimal(12, 2)
  maxUses      Int?
  usedCount    Int          @default(0)
  firstRideOnly Boolean     @default(false)
  userId       String?
  expiresAt    DateTime?
  isActive     Boolean      @default(true)
  fundingSource CouponFundingSource?
  platformShare Decimal?    @db.Decimal(5, 4)
  createdAt    DateTime     @default(now())

  trips Trip[]
}

model PromoCode {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String?
  discountType   DiscountType @default(PERCENT)
  value          Decimal      @db.Decimal(12, 2)
  currency       String?
  maxRedemptions Int?
  redeemedCount  Int          @default(0)
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  redemptions PromoCodeRedemption[]
}

// سجل استبدال رمز ترويجي: قيد فريد (promoCodeId,userId) يمنع
// الاستبدال المتكرر لكل مستخدم (حارس ذرّي ضد التزامن).
model PromoCodeRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String
  createdAt   DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([userId])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

// رمز الإحالة الخاص بكل مستخدم (يُولّد عند أول طلب).
model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
}

// إحالة: ربط مُحيل (referrer) بمُحال (referee). المُحال يُحال مرة واحدة
// فقط (قيد فريد على refereeId). المكافآت تُلتقط عند التأهّل للتدقيق.
model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  refereeId      String         @unique
  code           String
  status         ReferralStatus @default(PENDING)
  referrerReward Decimal?       @db.Decimal(12, 2)
  refereeReward  Decimal?       @db.Decimal(12, 2)
  currency       String?
  qualifiedAt    DateTime?
  rewardedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([referrerId])
  @@index([status])
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUST
}

// حساب ولاء لكل مستخدم: رصيد النقاط المتاح + النقاط التراكمية لحساب الفئة.
model LoyaltyAccount {
  id             String          @id @default(uuid())
  userId         String          @unique
  pointsBalance  Int             @default(0)
  lifetimePoints Int             @default(0)
  tier           LoyaltyTier     @default(BRONZE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  entries        LoyaltyLedger[]
}

// سجل غير قابل للتعديل لحركات النقاط (موجب = كسب، سالب = استبدال).
model LoyaltyLedger {
  id             String           @id @default(uuid())
  accountId      String
  account        LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           LoyaltyEntryType
  points         Int
  reason         String?
  referenceType  String?
  referenceId    String?
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now())

  @@index([accountId])
}

// ---------- Communication ----------
model Notification {
  id          String              @id @default(uuid())
  target      NotificationTarget  @default(USER)
  channel     NotificationChannel @default(PUSH)
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  campaignKey String?
  appId       String?
  clientOs    String?
  countryCodes String[]           @default([])
  localeCodes  String[]           @default([])
  driverCityIds String[]          @default([])
  title       String
  body        String
  imageUrl    String?
  deepLink    String?
  data        Json?
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int                 @default(0)
  // ---- التسليم الدائم (durable delivery): حالة + إعادة محاولة أسّية + DLQ ----
  // يُعاد استخدام enum OutboxStatus نفسه (PENDING/DELIVERED/FAILED/DEAD) تجنّبًا للتكرار.
  deliveryStatus OutboxStatus     @default(PENDING)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(8)
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt   DateTime            @default(now())

  @@index([userId])
  @@index([target])
  @@index([campaignKey])
  @@index([deliveryStatus, nextAttemptAt])
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  category  String?
  status    TicketStatus @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assigneeId      String?
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  resolutionCode  String?
  escalationLevel Int          @default(0)
  breached        Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages SupportMessage[]

  @@index([status])
  @@index([status, priority])
  @@index([assigneeId])
  @@index([slaDueAt])
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Rating {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  authorId  String
  author    User     @relation("RatingAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("RatingTarget", fields: [targetId], references: [id])
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([tripId])
}

model Complaint {
  id            String          @id @default(uuid())
  tripId        String?
  trip          Trip?           @relation(fields: [tripId], references: [id])
  fromUserId    String
  fromUser      User            @relation("ComplaintFrom", fields: [fromUserId], references: [id])
  againstUserId String?
  againstUser   User?           @relation("ComplaintAgainst", fields: [againstUserId], references: [id])
  message       String
  status        ComplaintStatus @default(OPEN)
  resolvedById  String?
  resolvedBy    User?           @relation("ComplaintResolver", fields: [resolvedById], references: [id])
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

// ---------- RBAC ----------
model AgentProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentCode   String      @unique
  status      AgentStatus @default(ACTIVE)
  cityId      String?
  city        City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  notes       String?
  createdById String?
  createdBy   User?       @relation("AgentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastLoginAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, cityId])
  @@index([createdById])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------- Geography & pricing ----------
model City {
  id        String   @id @default(uuid())
  name      String
  country   String?
  isActive  Boolean  @default(true)
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones        Zone[]
  pricingRules PricingRule[]
  drivers      Driver[]
  agents       AgentProfile[]
  trips        Trip[]
}

model Zone {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String
  polygon   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
}

model PricingRule {
  id        String    @id @default(uuid())
  cityId    String?
  city      City?     @relation(fields: [cityId], references: [id])
  rideClass RideClass @default(ECONOMY)
  baseFare  Decimal   @db.Decimal(12, 2)
  perKm     Decimal   @db.Decimal(12, 2)
  perMin    Decimal   @db.Decimal(12, 2)
  minFare   Decimal   @db.Decimal(12, 2)
  maxFare   Decimal?  @db.Decimal(12, 2)
  currency  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  peakPricing PeakPricing[]

  @@index([cityId])
}

model PeakPricing {
  id            String      @id @default(uuid())
  pricingRuleId String
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)
  name          String
  multiplier    Float       @default(1.5)
  startTime     String
  endTime       String
  daysOfWeek    Int[]
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([pricingRuleId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  relation  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Platform / system ----------
enum SettingPublicationStatus {
  DRAFT
  PUBLISHED
}

enum SettingChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Setting {
  id                String                   @id @default(uuid())
  key               String                   @unique
  value             Json
  publishedValue    Json?
  group             String?
  isPublic          Boolean                  @default(false)
  isSensitive       Boolean                  @default(false)
  publicationStatus SettingPublicationStatus @default(DRAFT)
  version           Int                      @default(1)
  publishedVersion  Int                      @default(0)
  publishedAt       DateTime?
  updatedAt         DateTime                 @updatedAt
  revisions         SettingRevision[]
  changeRequests    SettingChangeRequest[]

  @@index([group])
  @@index([isPublic, isSensitive])
  @@index([publicationStatus, isPublic, isSensitive])
}

model SettingChangeRequest {
  id                  String                     @id @default(uuid())
  settingId           String
  setting             Setting                    @relation(fields: [settingId], references: [id], onDelete: Cascade)
  requestedValue      Json
  sourceVersion       Int
  requestType         String                     @default("UPDATE")
  rollbackFromVersion Int?
  status              SettingChangeRequestStatus @default(PENDING)
  requestedById       String
  requestedBy         User                       @relation("SettingChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById        String?
  reviewedBy          User?                      @relation("SettingChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote          String?
  createdAt           DateTime                   @default(now())
  reviewedAt          DateTime?

  @@index([settingId, status])
  @@index([status, createdAt])
  @@index([requestedById])
  @@index([reviewedById])
}

model SettingRevision {
  id               String   @id @default(uuid())
  settingId        String
  setting          Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  publishedVersion Int
  sourceVersion    Int
  value            Json
  action           String   @default("PUBLISH")
  publishedById    String?
  createdAt        DateTime @default(now())

  @@unique([settingId, publishedVersion])
  @@index([settingId, createdAt])
  @@index([publishedById])
}

model AppVersion {
  id           String   @id @default(uuid())
  platform     String
  appId        String?
  clientOs     String?
  countryCodes String[] @default([])
  releaseChannel String @default("stable")
  status       String   @default("ACTIVE")
  version      String
  minSupported String?
  forceUpdate  Boolean  @default(false)
  rolloutPercentage Int @default(100)
  releaseNotes String?
  updateTitle  String?
  updateMessage String?
  url          String?
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([platform])
  @@index([platform, releaseChannel, status])
  @@index([appId, clientOs])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([userId, revoked])
  @@index([userId, sessionId, revoked])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("info")
  message   String
  context   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
}

/// أنواع المركبات المعروضة في التطبيق (اقتصادي، مريح، فان...) — تُدار من لوحة التحكم
// فئة مركبات ديناميكية (سيارات / دراجات / أي فئة جديدة يضيفها المدير).
model VehicleCategory {
  id              String   @id @default(uuid())
  name            String   @unique
  nameI18n        Json? // { ar, fr, en }
  description     String?
  descriptionI18n Json?
  iconType        String   @default("EMOJI") // EMOJI | ICON_PACK | SVG | PNG | LOTTIE
  iconValue       String? // رمز إيموجي أو مفتاح داخل حزمة أيقونات
  iconUrl         String? // رابط ملف SVG/PNG/Lottie (URL أو File ID فقط)
  imageUrl        String?
  color           String?
  usageType       String   @default("BOTH") // RIDE | DELIVERY | BOTH
  domain          String   @default("MOBILITY") // MOBILITY | FOOD | PARCEL | CORPORATE | RENTAL — كتالوج قابل لإعادة الاستخدام
  status          WorkflowStatus @default(PUBLISHED)
  version         Int      @default(1) // يتغير مع كل تعديل — للـ smart cache
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  deletedAt       DateTime? // حذف ناعم
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  types VehicleType[]

  @@index([isActive])
  @@index([domain])
  @@index([deletedAt])
}

// ��وع المركبة = خدمة كاملة. كل الخصائص والميزات ��الأسعار تُدار من لوحة التحكم.
model VehicleType {
  id              String           @id @default(uuid())
  categoryId      String?
  category        VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  nameI18n        Json?
  description     String?
  descriptionI18n Json?
  rideClass       RideClass        @default(ECONOMY) // للتوافق مع البيانات القديمة
  multiplier      Float            @default(1)
  capacity        Int              @default(4)
  luggage         Int              @default(0)
  notes           String?
  usageType       String           @default("BOTH") // RIDE | DELIVERY | BOTH

  // خصائص الخدمة (تُدار من اللوحة)
  allowsNegotiation   Boolean @default(false)
  supportsCash        Boolean @default(true)
  supportsWallet      Boolean @default(true)
  requiresApproval    Boolean @default(false)
  visibleToPassengers Boolean @default(true)
  visibleToDrivers    Boolean @default(true)
  appIds              String[] @default([])
  clientOs            String[] @default([])
  countryCodes        String[] @default([])
  audienceSegments    String[] @default([])
  minAppVersion       String?
  maxAppVersion       String?
  badgeText           String?
  etaMinutes          Int?

  // أيقونات مرنة (Icon Pack / SVG / PNG / Lottie)
  iconType  String  @default("EMOJI")
  iconValue String?
  iconUrl   String?
  imageUrl  String?
  color     String?

  // متطلبات القبول لهذا النوع — يتحقق منها النظام تلقائياً
  minVehicleYear      Int?
  minDriverRating     Float?
  minDriverTrips      Int?
  requiredLicenseType String?
  requiredDocuments   String[] @default([]) // أنواع مستندات إلزامية
  requiredPhotos      String[] @default([]) // صور إلزامية
  requirements        Json? // متطلبات إضافية مرنة

  // دورة حياة النشر (Workflow) + الإصدار + الحذف الناعم
  status    WorkflowStatus @default(DRAFT)
  version   Int       @default(1)
  deletedAt DateTime?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features     VehicleTypeFeature[]
  pricingRules VehiclePricingRule[]
  fields       VehicleTypeField[]
  vehicles     Vehicle[]
  trips        Trip[]

  @@unique([categoryId, name])
  @@index([isActive])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

// ميزات مرنة (مكيف/براد/واي فاي/شاحن/كرسي أطفال...) تُضاف من اللوحة دون تعديل قاعدة البيانات.
model Feature {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameI18n  Json?
  iconType  String   @default("EMOJI")
  iconValue String?
  iconUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  types VehicleTypeFeature[]

  @@index([isActive])
  @@index([deletedAt])
}

// جد��ل الربط بين النوع والميزات (متعدد-إلى-متعدد).
model VehicleTypeFeature {
  vehicleTypeId String
  featureId     String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  feature       Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([vehicleTypeId, featureId])
  @@index([featureId])
}

// مناطق الخدمة (اسم/مدينة/ولاية/دولة/حدود GeoJSON/تفعيل). يرتبط بها التسعير.
model ServiceArea {
  id        String   @id @default(uuid())
  name      String
  city      String?
  state     String?
  country   String?
  geojson     Json? // Polygon / GeoJSON — تمثيل هندسي عام مستقل عن مزوّد الخرائط
  provider    String   @default("GEOJSON") // GEOJSON | GOOGLE | OSM | MAPBOX
  providerRef Json? // معرفات خاصة بالمزوّد (اختياري) دون تغيير المخطط
  centerLat Float?
  centerLng Float?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules VehiclePricingRule[]

  @@index([isActive])
  @@index([deletedAt])
}

// نظام تسعير مرن: عدة قواعد سعر لكل نوع مركبة، تختلف حسب المنطقة/المدينة/الولاية/الدولة/
// الوقت/الذروة/المناسبات/نوع العميل/العروض/الكوبونات. يُختار أنسبها حسب الأولوية والتطابق.
model VehiclePricingRule {
  id            String       @id @default(uuid())
  vehicleTypeId String
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  name          String?

  // النطاق الجغرافي
  serviceAreaId String?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  cityId        String?
  state         String?
  country       String?

  // نوع العميل والعروض والكوبونات
  customerType String? // ALL | NEW | VIP ...
  couponCode   String?
  appIds       String[] @default([])
  clientOs     String[] @default([])
  audienceSegments String[] @default([])
  minAppVersion String?
  maxAppVersion String?

  // النافذة الزمنية / المناسبات / الذروة
  validFrom      DateTime?
  validTo        DateTime?
  daysOfWeek     Int[]     @default([])
  startTime      String? // HH:MM
  endTime        String? // HH:MM
  peakMultiplier Float     @default(1)

  // القيم
  baseFare       Decimal  @db.Decimal(12, 2)
  perKm          Decimal  @db.Decimal(12, 2)
  perMin         Decimal  @db.Decimal(12, 2)
  minFare        Decimal  @db.Decimal(12, 2)
  maxFare        Decimal? @db.Decimal(12, 2)
  negotiationMin Decimal? @db.Decimal(12, 2)
  negotiationMax Decimal? @db.Decimal(12, 2)
  commissionPct  Float    @default(15)
  currency       String
  metadata       Json?

  priority  Int      @default(0) // الأعلى يفوز عند تطابق أكثر من قاعدة
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleTypeId])
  @@index([serviceAreaId])
  @@index([isActive])
  @@index([deletedAt])
}

// حقول ديناميكية يعرّفها المدير لكل نوع (Dynamic Forms) دون تعديل الكود.
model VehicleTypeField {
  id            String      @id @default(uuid())
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  key           String // مفتاح برمجي، مثل: hasWater
  label         String
  labelI18n     Json? // { ar, fr, en }
  fieldType     String      @default("TEXT") // TEXT | NUMBER | BOOLEAN | SELECT | MULTISELECT
  options       Json? // خيارات SELECT/MULTISELECT
  required      Boolean     @default(false)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([vehicleTypeId, key])
  @@index([vehicleTypeId])
}

/// الإعلانات/البانرات المعروضة في تطبيقي الراكب والسائق
model Advertisement {
  id        String      @id @default(uuid())
  title     String
  imageUrl  String
  targetUrl String?
  campaignKey String?
  placement AdPlacement @default(PASSENGER_HOME)
  appId     String?
  clientOs  String?
  countryCodes String[] @default([])
  audienceSegments String[] @default([])
  isActive  Boolean     @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  priority  Int         @default(0)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([placement, isActive])
  @@index([campaignKey])
}

enum AdPlacement {
  PASSENGER_HOME
  PASSENGER_SEARCH
  DRIVER_HOME
  ALL
}

// ---------- Transactional Outbox (durable events + DLQ) ----------
enum OutboxStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

/// صندوق صادر دائم للأحداث الحرجة: يُكتب داخل نفس معاملة قاعدة البيانات
/// لعم��ية العمل، ثم يُسلّمه relay دوري مع إعادة محاولة أسّ��ة و DLQ.
model OutboxEvent {
  id          String       @id @default(cuid())
  name        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(10)
  availableAt DateTime     @default(now())
  lastError   String?
  dedupeKey   String?      @unique
  deliveredAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([name])
  @@index([status, deliveredAt])
  @@index([status, updatedAt])
}

// ---------- Country Config (Multi-Country) ----------
enum CountryTaxMode {
  INCLUSIVE
  EXCLUSIVE
}

/// إعداد بلد قابل للتخصيص: يتجاوز الافتراضات المدمجة في الكود.
/// يحمل العملة والضريبة وتنسيق الهاتف والمنطقة الزمنية وطرق الدفع.
model CountryConfig {
  code                 String         @id
  name                 String
  currency             String
  dialCode             String
  nationalNumberLength Int            @default(9)
  locale               String
  timezone             String
  taxRatePct           Float          @default(0)
  taxMode              CountryTaxMode @default(EXCLUSIVE)
  paymentMethods       String[]       @default([])
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([isActive])
}

// ---------- Fraud & Risk ----------
enum RiskDecisionKind {
  ALLOW
  REVIEW
  BLOCK
}

enum RiskLevelKind {
  LOW
  MEDIUM
  HIGH
}

enum BlacklistKind {
  USER
  DEVICE
  IP
  PHONE
  CARD
}

enum RiskReviewStatus {
  OPEN
  APPROVED
  REJECTED
}

/// سجلّ تقييم مخاطر: لقطة غير قابلة للتعديل لكل إجراء حسّاس (للتدقيق).
model RiskEvent {
  id          String          @id @default(cuid())
  subjectKind String
  subjectId   String
  action      String
  score       Int
  level       RiskLevelKind
  decision    RiskDecisionKind
  amount      Float?
  reasons     Json
  createdAt   DateTime        @default(now())

  @@index([subjectKind, subjectId])
  @@index([decision, createdAt])
}

/// قائمة حظر متعددة الأنواع (مستخدم/جهاز/IP/هاتف/بطاقة).
model BlacklistEntry {
  id        String        @id @default(cuid())
  kind      BlacklistKind
  value     String
  reason    String?
  active    Boolean       @default(true)
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([kind, value])
  @@index([kind, active])
}

/// طابور المراجعة اليدوية للإج��اءات المشبوهة (قرار REVIEW).
model RiskReview {
  id          String           @id @default(cuid())
  riskEventId String?
  subjectKind String
  subjectId   String
  action      String
  score       Int
  status      RiskReviewStatus @default(OPEN)
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, score])
}

/// حجز يدوي على كيان (يمنع الإجراءات الحسّاسة حتّى الإفرا��).
model RiskHold {
  id          String    @id @default(cuid())
  subjectKind String
  subjectId   String
  reason      String?
  active      Boolean   @default(true)
  createdBy   String?
  releasedBy  String?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([subjectKind, subjectId, active])
}

// ============================================================
// P2: توسّعات ما بعد الإطلاق (جدولة / دعم / تسوية / نمو / توسّع)
// ============================================================

enum TicketPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum PayoutBatchStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  PAID
  FAILED
  CANCELED
}

enum PayoutItemStatus {
  PENDING
  PAID
  FAILED
}

enum IncentiveKind {
  TRIP_COUNT
  EARNINGS_THRESHOLD
  ACCEPTANCE_RATE
  STREAK_DAYS
}

enum CityLaunchStatus {
  PLANNED
  PILOT
  LIVE
  PAUSED
}

/// توقف ضمن رحلة متعددة التوقفات (multi-stop).
model TripStop {
  id        String    @id @default(uuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seq       Int
  lat       Float
  lng       Float
  address   String?
  arrivedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([tripId, seq])
  @@index([tripId])
}

/// دفعة تسوية بنكية للسائقين.
model PayoutBatch {
  id            String            @id @default(uuid())
  reference     String            @unique
  provider      String            @default("manual")
  status        PayoutBatchStatus @default(DRAFT)
  currency      String
  totalMinor    Int               @default(0)
  itemCount     Int               @default(0)
  submittedAt   DateTime?
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  createdBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items PayoutItem[]

  @@index([status, createdAt])
  @@index([provider, status])
}

/// عنصر داخل دفعة تسوية (مرتبط بطلب سحب).
model PayoutItem {
  id                String           @id @default(uuid())
  batchId           String
  batch             PayoutBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  driverId          String
  withdrawRequestId String?
  amountMinor       Int
  currency          String
  iban              String?
  bankRef           String?
  status            PayoutItemStatus @default(PENDING)
  failureReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([batchId])
  @@index([driverId])
}

/// حافز للسائقين (مهمّة/هدف + مكا��أة).
model Incentive {
  id          String        @id @default(uuid())
  name        String
  kind        IncentiveKind
  cityId      String?
  targetValue Float
  rewardMinor Int
  currency    String
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean       @default(true)
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  progress DriverIncentiveProgress[]

  @@index([active, startsAt, endsAt])
  @@index([cityId])
}

/// تقدّم سائق نحو حافز معيّن.
model DriverIncentiveProgress {
  id          String    @id @default(uuid())
  incentiveId String
  incentive   Incentive @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  driverId    String
  progress    Float     @default(0)
  target      Float
  achieved    Boolean   @default(false)
  rewardMinor Int       @default(0)
  awardedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([incentiveId, driverId])
  @@index([driverId])
}

/// تجربة A/B للتسعير.
model PricingExperiment {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  variants    Json
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ExperimentAssignment[]

  @@index([active])
}

/// تعيين حتمي لمتغيّر تجربة لهدف (سائق/راكب).
model ExperimentAssignment {
  id           String            @id @default(uuid())
  experimentId String
  experiment   PricingExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  subjectId    String
  variant      String
  assignedAt   DateTime          @default(now())

  @@unique([experimentId, subjectId])
  @@index([experimentId, variant])
}

/// ضوابط التوسّع لكل مدينة (حالة إطلاق + سقوف سعة + فئات مفعّلة).
model CityScalingControl {
  id                 String           @id @default(uuid())
  cityId             String           @unique
  launchStatus       CityLaunchStatus @default(PLANNED)
  maxActiveDrivers   Int?
  maxDailyTrips      Int?
  enabledRideClasses String[]
  surgeCap           Float?
  notes              String?
  createdBy          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([launchStatus])
}

// ===================== الشروط القانونية والموافقة =====================

enum LegalDocumentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  DRIVER_AGREEMENT
  COOKIE_POLICY
  REFUND_POLICY
}

enum LegalAudience {
  ALL
  PASSENGER
  DRIVER
}

model LegalDocument {
  id                 String            @id @default(uuid())
  type               LegalDocumentType
  audience           LegalAudience     @default(ALL)
  locale             String            @default("ar")
  title              String
  body               String
  summary            String?
  version            Int               @default(1)
  status             WorkflowStatus    @default(DRAFT)
  requiresAcceptance Boolean           @default(true)
  publishedVersion   Int               @default(0)
  publishedTitle     String?
  publishedBody      String?
  publishedAt        DateTime?
  effectiveAt        DateTime?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  versions LegalDocumentVersion[]
  consents UserConsent[]

  @@unique([type, audience, locale])
  @@index([status])
  @@index([isActive])
}

model LegalDocumentVersion {
  id            String        @id @default(uuid())
  documentId    String
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int
  title         String
  body          String
  effectiveAt   DateTime?
  publishedById String?
  createdAt     DateTime      @default(now())

  consents UserConsent[]

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model UserConsent {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId        String
  document          LegalDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String?
  documentVersion   LegalDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  version           Int
  acceptedAt        DateTime              @default(now())
  ipAddress         String?
  userAgent         String?
  source            String?

  @@unique([userId, documentId, version])
  @@index([userId])
  @@index([documentId])
}

enum SavedPlaceKind {
  HOME
  WORK
  RECENT
  OTHER
}

/// أماكن المستخدم المحفوظة (منزل/عمل/أخيرة/أخرى) — مصدر الحقيقة في الباكند.
model SavedPlace {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       SavedPlaceKind @default(OTHER)
  label      String
  address    String
  lat        Float
  lng        Float
  placeId    String?
  meta       Json?
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, kind])
  @@index([userId, lastUsedAt])
}

// ---------- مفاتيح الميزات (Feature Flags) ----------
// مُطابِقة لهجرتَي 20260713180000_feature_flags و
// 20260713193000_feature_flag_advanced_targeting (مواءمة انجراف المخطط
// دون هجرة جديدة — الجداول موجودة مسبقًا في قاعدة البيانات).
enum FeatureFlagPlatform {
  ALL
  PASSENGER
  DRIVER
  DASHBOARD
}

/// مفتاح ميزة مع استهداف متقدّم (مدن/دول/تطبيقات/أنظمة/شرائح) وخطة توزيع تدريجي.
model FeatureFlag {
  id                String              @id @default(uuid())
  key               String              @unique
  description       String?
  enabled           Boolean             @default(false)
  platform          FeatureFlagPlatform @default(ALL)
  cityIds           String[]            @default([])
  countryCodes      String[]            @default([])
  appIds            String[]            @default([])
  clientOs          String[]            @default([])
  audienceSegments  String[]            @default([])
  rolloutPercentage Int                 @default(100)
  rolloutPlan       Json?
  minAppVersion     String?
  maxAppVersion     String?
  startsAt          DateTime?
  endsAt            DateTime?
  version           Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([enabled, platform])
  @@index([startsAt, endsAt])
}

/// تحكّم عام في مفاتيح الميزات (مفتاح إيقاف طارئ عام واحد بالمفتاح "global").
model FeatureFlagControl {
  key              String   @id
  globalKillSwitch Boolean  @default(false)
  globalKillReason String?
  updatedAt        DateTime @updatedAt
}

// ---------- عرض السعر التفاوضي (FareQuote — نموذج inDrive) ----------
// الراكب يحصل على سعر مقترَح + نطاق تفاوض [min,max]، ثم يقترح سعره.
// جدول مستقل (معرّفات كسلاسل دون مفاتيح أجنبية) للحفاظ على ��لتوافق الرجعي
// وعدم المساس بنماذج User/Trip/City. العرض مؤقت وينتهي (expiresAt).
enum FareQuoteStatus {
  QUOTED
  PROPOSED
  ACCEPTED
  EXPIRED
  CANCELLED
}

model FareQuote {
  id            String          @id @default(uuid())
  passengerId   String
  rideClass     RideClass       @default(ECONOMY)
  vehicleTypeId String?
  cityId        String?
  pickupLat     Float
  pickupLng     Float
  pickupAddress String?
  destLat       Float?
  destLng       Float?
  destAddress   String?
  distanceKm    Float?
  durationSec   Int?
  currency      String
  suggestedFare Decimal         @db.Decimal(12, 2)
  minFare       Decimal         @db.Decimal(12, 2)
  maxFare       Decimal         @db.Decimal(12, 2)
  proposedFare  Decimal?        @db.Decimal(12, 2)
  commissionPct Float           @default(15)
  pricingSource String?
  pricingRuleId String?
  status        FareQuoteStatus @default(QUOTED)
  expiresAt     DateTime
  proposedAt    DateTime?
  tripId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([passengerId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

// ---------- عروض السائقين المضادة (FareOffer — مزايدة inDrive) ----------
// السائق يقدّم عرضًا مضادًا على FareQuote، ثم يختار الراكب عرضًا.
// جدول مستقل (معرّفات كسلاسل دون مفاتيح أجنبية) مثل FareQuote، حفاظًا على التوافق الرجعي.
// driverId = معرّف سجل Driver (متوافق مع Trip.driverId).
enum FareOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model FareOffer {
  id          String          @id @default(uuid())
  fareQuoteId String
  driverId    String
  amount      Decimal         @db.Decimal(12, 2)
  currency    String
  note        String?
  etaMinutes  Int?
  status      FareOfferStatus @default(PENDING)
  expiresAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([fareQuoteId, status])
  @@index([driverId, status])
  @@index([createdAt])
}

// ===== Stage 64: User Identity Verification (tahqiq hawiyat al-mustakhdim - KYC) =====
enum IdentityDocType {
  NATIONAL_ID
  PASSPORT
  DRIVING_LICENSE
  RESIDENCE_PERMIT
}

enum IdentityVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model UserIdentityVerification {
  id           String                     @id @default(uuid())
  userId       String
  user         User                       @relation("UserIdentities", fields: [userId], references: [id], onDelete: Cascade)
  docType      IdentityDocType
  docNumber    String?
  frontUrl     String
  backUrl      String?
  selfieUrl    String?
  status       IdentityVerificationStatus @default(PENDING)
  note         String?
  reviewedById String?
  reviewedBy   User?                      @relation("IdentityReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([userId])
  @@index([status])
}

enum VehicleVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageTemplateCategory {
  TRANSACTIONAL
  MARKETING
  SYSTEM
  SUPPORT
}

model MessageTemplate {
  id          String                  @id @default(uuid())
  key         String
  locale      String                  @default("ar")
  name        String
  description String?
  category    MessageTemplateCategory @default(TRANSACTIONAL)
  channel     NotificationChannel?
  title       String
  body        String
  variables   String[]                @default([])
  isActive    Boolean                 @default(true)
  sortOrder   Int                     @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([key, locale])
  @@index([key])
  @@index([isActive])
  @@index([category])
}

// ---------- Content Blocks (dashboard-managed dynamic app content) ----------
enum ContentBlockType {
  ANNOUNCEMENT
  ONBOARDING
  FAQ
  INFO
  HELP
  PROMO
}

enum ContentAudience {
  ALL
  PASSENGER
  DRIVER
}

/// كتل محتوى ديناميكية تُدار من لوحة التحكم (إعلانات داخلية/onboarding/FAQ...)
/// مترجمة ومستهدفة حسب الجمهور، بنافذة عرض اختيارية. لا تسعير/خصم.
model ContentBlock {
  id          String           @id @default(uuid())
  slug        String
  locale      String           @default("ar")
  type        ContentBlockType @default(INFO)
  audience    ContentAudience  @default(ALL)
  title       String
  body        String
  imageUrl    String?
  ctaLabel    String?
  ctaUrl      String?
  tags        String[]         @default([])
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([slug, locale, audience])
  @@index([type, audience, isActive])
  @@index([slug])
  @@index([isActive])
}

// ---------- Backup / Restore / Disaster Recovery ----------
enum BackupKind {
  DATABASE
  FILES
  FULL
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
  SYSTEM
}

/// سجلّ ميتاداتا النسخ الاحتياطية (يُنفّذ النسخ فعليًا خارجيًا)
/// لمتابعة حالة DR مقابل RPO وتطبيق سياسة الاستبقاء. لا تسعير/خصم.
model BackupRecord {
  id              String        @id @default(uuid())
  kind            BackupKind    @default(DATABASE)
  status          BackupStatus  @default(PENDING)
  trigger         BackupTrigger @default(SCHEDULED)
  storageLocation String?
  sizeMb          Int?
  checksum        String?
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  error           String?
  retained        Boolean       @default(true)
  triggeredById   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([kind, status])
  @@index([status, startedAt])
  @@index([startedAt])
}
